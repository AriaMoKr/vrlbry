{
  "name": "vrlbry",
  "version": "0.1.0",
  "description": "A candle-lit 3D library for Kiwix ZIM files: walk the shelves and read Project Gutenberg, Wikipedia and Wikisource in VR (Meta Quest), on a desktop or a phone.",
  "keywords": ["webxr", "virtual-reality", "threejs", "meta-quest", "kiwix", "zim", "openzim", "project-gutenberg", "wikipedia", "wikisource", "ebook-reader", "digital-library", "offline-first"],
  "homepage": "https://ariamokr.github.io/vrlbry/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AriaMoKr/vrlbry.git"
  },
  "bugs": {
    "url": "https://github.com/AriaMoKr/vrlbry/issues"
  },
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "bin": {
    "vrlbry": "server/index.js"
  },
  "scripts": {
    "start": "node server/index.js",
    "start:https": "node server/index.js --https",
    "test": "node --test \"test/*.test.js\"",
    "perf:quest": "node tools/quest-perf.mjs",
    "build:pages": "node tools/build-pages.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "htmlparser2": "^12.0.0",
    "selfsigned": "^5.5.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "iwer": "^2.5.0"
  }
}
